# Alien-Glass Plank Theme — Generated from branding/tokens.env
[PlankTheme]
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=255;;255;;255;;190
FillStartColor=240;;240;;240;;135
FillEndColor=225;;230;;240;;155
InnerStrokeColor=255;;255;;255;;100

[PlankDockTheme]
HorizPadding=8
TopPadding=4
BottomPadding=4
ItemPadding=5
IndicatorSize=5
IconShadowSize=2
UrgentBounceHeight=1.66
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=25
GlowTime=8000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=400
CascadeHide=true
BadgeColor=79;;142;;247;;255
