#!/bin/sh
# Alien OS — GPU & Hardware Acceleration Diagnostic (alien-gpu-check)
# Checks VA-API video decode profiles, OpenGL, Vulkan, and driver state.
set -eu

echo "=== Alien OS GPU & Hardware Acceleration Report ==="

# 1. GPU Detection
printf "\n--- Detected Graphics Hardware ---\n"
if command -v lspci >/dev/null 2>&1; then
	lspci -nn | grep -E -i "vga|3d|display" || true
else
	echo "lspci not available."
fi

# 2. Driver / Kernel module
printf "\n--- Kernel DRM Driver ---\n"
if [ -d "/sys/class/drm" ]; then
	for card in /sys/class/drm/card[0-9]; do
		[ -d "$card" ] || continue
		card_name="${card##*/}"
		driver_path="$card/device/driver"
		if [ -L "$driver_path" ]; then
			echo "$card_name driver: $(basename "$(readlink "$driver_path")")"
		fi
	done
else
	echo "No DRM cards found."
fi

# 3. VA-API Acceleration Check
printf "\n--- Video Acceleration (VA-API) ---\n"
if command -v vainfo >/dev/null 2>&1; then
	vainfo 2>&1 | grep -E "Driver version|VAProfile" | head -n 15 || true
else
	echo "vainfo not installed. Install 'vainfo' to test VA-API profiles."
	if [ -d "/usr/lib/x86_64-linux-gnu/dri" ]; then
		echo "Available DRI / VA-API drivers:"
		ls -1 /usr/lib/x86_64-linux-gnu/dri/*_drv_video.so 2>/dev/null || echo "None found in /usr/lib/x86_64-linux-gnu/dri/"
	fi
fi

# 4. Vulkan Support
printf "\n--- Vulkan Capabilities ---\n"
if command -v vulkaninfo >/dev/null 2>&1; then
	vulkaninfo --summary 2>/dev/null || true
else
	echo "vulkaninfo not installed."
	if [ -d "/usr/share/vulkan/icd.d" ]; then
		echo "Configured Vulkan ICD drivers:"
		ls -1 /usr/share/vulkan/icd.d/ 2>/dev/null || echo "None found."
	fi
fi

# 5. OpenGL Acceleration
printf "\n--- OpenGL Renderer ---\n"
if command -v glxinfo >/dev/null 2>&1; then
	glxinfo -B 2>/dev/null | grep -E "OpenGL renderer string|OpenGL core profile version" || true
else
	echo "glxinfo not installed."
fi
