[Desktop Entry]
Type=Application
Name=Alien App Center
GenericName=Software Store
Comment=Discover, install, and update applications and add-on bundles
Exec=alien-app-center
Icon=alien-launcher
Terminal=false
Categories=System;Settings;PackageManager;Qt;
StartupWMClass=alien-app-center
Actions=Bundles;Updates;

[Desktop Action Bundles]
Name=Add-On Bundles
Exec=alien-app-center --tab bundles

[Desktop Action Updates]
Name=Check for Updates
Exec=alien-app-center --tab updates
