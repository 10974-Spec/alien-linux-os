# Allow apt to fetch HTTPS repositories during chroot stage before ca-certificates is fully configured
Acquire::https::packages.microsoft.com::Verify-Peer "false";
Acquire::https::packages.microsoft.com::Verify-Host "false";
Acquire::https::brave-browser-apt-release.s3.brave.com::Verify-Peer "false";
Acquire::https::brave-browser-apt-release.s3.brave.com::Verify-Host "false";
Acquire::Retries "5";
Acquire::http::Timeout "45";
Acquire::ForceIPv4 "true";
