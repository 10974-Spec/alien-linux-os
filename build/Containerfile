# Clean Debian build environment for Alien.
# Used by build/build.sh — you never need to run this by hand.
FROM docker.io/library/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      live-build debootstrap squashfs-tools xorriso \
      grub-pc-bin grub-efi-amd64-bin grub-efi-amd64-signed shim-signed \
      grub-common mtools dosfstools isolinux syslinux syslinux-common syslinux-utils \
      ca-certificates curl wget gnupg rsync cpio zstd xz-utils file \
      librsvg2-bin imagemagick python3 apt-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /alien
